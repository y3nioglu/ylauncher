{
  "name": "mc-friends-launcher",
  "version": "0.1.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/y3nioglu/ylauncher.git"
  },
  "description": "Arkadas grubu icin ozel Minecraft launcher",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n api,app -c yellow,cyan \"npm:dev:server\" \"npm:dev:app\"",
    "dev:app": "electron-vite dev",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "migrate": "tsx server/migrate.ts",
    "typecheck": "tsc --noEmit",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "testpack": "node scripts/testpack.mjs",
    "testpack:push": "node scripts/testpack.mjs --push"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "extract-zip": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "minecraft-launcher-core": "^3.18.2",
    "electron-updater": "^6.6.2",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "com.mcfriends.launcher",
    "productName": "MC Friends Launcher",
    "artifactName": "MC-Friends-Launcher-Setup-${version}.${ext}",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [],
    "asarUnpack": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MC Friends Launcher"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "y3nioglu",
        "repo": "ylauncher",
        "releaseType": "release"
      }
    ]
  }
}
